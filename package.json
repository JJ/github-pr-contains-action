{
   "name": "github-pr-contains-action",
   "version": "14",
   "private": false,
   "description": "An action that performs checks on PRs",
   "main": "lib/main.js",
   "type": "module",
   "scripts": {
      "build": "tsc && esbuild lib/main.js --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js --sourcemap --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
      "test": "jest"
   },
   "repository": {
      "type": "git",
      "url": "git+https://github.com/actions/github-pr-contains-action.git"
   },
   "keywords": [
      "actions",
      "node",
      "diff",
      "pull request"
   ],
   "author": "JJ Merelo",
   "license": "MIT",
   "devDependencies": {
      "@actions/core": "^3.0.0",
      "@actions/github": "^9.1.1",
      "@swc/core": "^1.15.47",
      "@swc/jest": "^0.2.39",
      "@types/jest": "^29.2.6",
      "@types/node": "^26.1.2",
      "esbuild": "^0.28.1",
      "jest": "^29.3.1",
      "parse-diff": "^0.6.0",
      "typescript": "^7.0.2"
   }
}
